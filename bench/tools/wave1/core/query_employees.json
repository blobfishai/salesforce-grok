{
 "name": "query_employees",
 "mcp_name": "core.query_employees",
 "asset_namespace": "core",
 "description": "Search and filter employees. Returns matching rows. Declared lifecycle: employees.status: active → on_leave → terminated. Use this to resolve a human name, title, external code, or other business handle to the exact employees primary key required by item tools.",
 "type": "read",
 "target_tables": [
  "employees"
 ],
 "parameters": {
  "id": "INTEGER",
  "employee_number": "TEXT",
  "name": "TEXT",
  "email": "TEXT",
  "job_title": "TEXT",
  "department_id": "INTEGER",
  "hire_date": "TEXT",
  "status": "TEXT",
  "limit": "INTEGER"
 },
 "input_schema": {
  "type": "object",
  "properties": {
   "id": {
    "type": "integer"
   },
   "employee_number": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "email": {
    "type": "string"
   },
   "job_title": {
    "type": "string"
   },
   "department_id": {
    "type": "integer"
   },
   "hire_date": {
    "type": "string"
   },
   "status": {
    "type": "string",
    "enum": [
     "active",
     "on_leave",
     "terminated"
    ],
    "description": "Declared lifecycle: active → on_leave → terminated."
   },
   "limit": {
    "type": "integer"
   }
  },
  "additionalProperties": false
 }
}