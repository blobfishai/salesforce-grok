{
 "name": "query_support_tickets",
 "mcp_name": "jira.query_support_tickets",
 "asset_namespace": "jira",
 "description": "Search and filter support_tickets. Returns matching rows. Declared lifecycle: support_tickets.status: open → in_progress → waiting_customer → resolved → closed. Use this to resolve a human name, title, external code, or other business handle to the exact support_tickets primary key required by item tools.",
 "type": "read",
 "target_tables": [
  "support_tickets"
 ],
 "parameters": {
  "id": "INTEGER",
  "ticket_number": "TEXT",
  "subject": "TEXT",
  "customer_name": "TEXT",
  "priority": "TEXT",
  "assignee_employee_id": "INTEGER",
  "opened_at": "TEXT",
  "lead_management_sop_id": "INTEGER",
  "status": "TEXT",
  "limit": "INTEGER"
 },
 "input_schema": {
  "type": "object",
  "properties": {
   "id": {
    "type": "integer"
   },
   "ticket_number": {
    "type": "string"
   },
   "subject": {
    "type": "string"
   },
   "customer_name": {
    "type": "string"
   },
   "priority": {
    "type": "string"
   },
   "assignee_employee_id": {
    "type": "integer"
   },
   "opened_at": {
    "type": "string"
   },
   "lead_management_sop_id": {
    "type": "integer"
   },
   "status": {
    "type": "string",
    "enum": [
     "open",
     "in_progress",
     "waiting_customer",
     "resolved",
     "closed"
    ],
    "description": "Declared lifecycle: open → in_progress → waiting_customer → resolved → closed."
   },
   "limit": {
    "type": "integer"
   }
  },
  "additionalProperties": false
 }
}