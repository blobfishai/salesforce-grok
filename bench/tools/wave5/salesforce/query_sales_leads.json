  "contact_name": "TEXT",
  "source": "TEXT",
  "estimated_value": "REAL",
  "owner_employee_id": "INTEGER",
  "created_at": "TEXT",
  "status": "TEXT",
  "limit": "INTEGER"
 },
 "input_schema": {
