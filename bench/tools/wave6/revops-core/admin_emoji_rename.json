{
 "name": "admin_emoji_rename",
 "mcp_name": "core.admin_emoji_rename",
 "asset_namespace": "core",
 "description": "Rename an emoji. (POST /admin.emoji.rename)",
 "type": "write",
 "target_tables": [
  "admin_emojis"
 ],
 "parameters": {
  "token": "string",
  "name": "string",
  "new_name": "string"
 },
 "input_schema": {
  "type": "object",
  "properties": {
   "token": {
    "type": "string",
    "description": "Authentication token. Requires scope: `admin.teams:write`"
   },
   "name": {
    "type": "string",
    "description": "The name of the emoji to be renamed. Colons (`:myemoji:`) around the value are not required, although they may be included."
   },
   "new_name": {
    "type": "string",
    "description": "The new name of the emoji."
   }
  },
  "required": [
   "token",
   "name",
   "new_name"
  ],
  "additionalProperties": false
 }
}