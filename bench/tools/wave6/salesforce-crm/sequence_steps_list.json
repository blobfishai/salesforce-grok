{
 "name": "sequence_steps_list",
 "mcp_name": "salesforce.sequence_steps_list",
 "asset_namespace": "salesforce",
 "description": "List the ordered steps of a sequence with delays and A/B variants (GET /api/v2/sequenceSteps).",
 "type": "read",
 "target_tables": [
  "outreach_sequence_steps"
 ],
 "parameters": {
  "sequence_id": "string",
  "channel": "string",
  "variant": "string",
  "limit": "integer"
 },
 "input_schema": {
  "type": "object",
  "properties": {
   "sequence_id": {
    "type": "string",
    "description": "Sequence whose steps to return."
   },
   "channel": {
    "type": "string",
    "description": "Filter by channel: email or call."
   },
   "variant": {
    "type": "string",
    "description": "Filter by A/B variant."
   },
   "limit": {
    "type": "integer",
    "description": "Maximum number of records to return (default 30)."
   }
  },
  "additionalProperties": false
 }
}