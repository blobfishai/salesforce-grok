{
 "name": "forecast_submit",
 "mcp_name": "salesforce.forecast_submit",
 "asset_namespace": "salesforce",
 "description": "Submit a forecast number in a category for a rep and period (POST /services/data/v62.0/sobjects/ForecastingItem).",
 "type": "write",
 "target_tables": [
  "forecast_submissions"
 ],
 "parameters": {
  "employee_id": "integer",
  "employee_name": "string",
  "period": "string",
  "category": "string",
  "amount": "number",
  "status": "string"
 },
 "input_schema": {
  "type": "object",
  "properties": {
   "employee_id": {
    "type": "integer",
    "description": "Rep the forecast belongs to."
   },
   "employee_name": {
    "type": "string",
    "description": "Rep display name."
   },
   "period": {
    "type": "string",
    "description": "Fiscal period, e.g. 2026-Q3."
   },
   "category": {
    "type": "string",
    "description": "Forecast category: commit, best_case or pipeline."
   },
   "amount": {
    "type": "number",
    "description": "Forecast amount in USD."
   },
   "status": {
    "type": "string",
    "description": "Submission status; defaults to submitted."
   }
  },
  "required": [
   "employee_id",
   "period",
   "category",
   "amount"
  ],
  "additionalProperties": false
 }
}