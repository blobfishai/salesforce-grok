{
 "name": "signature_envelope_create",
 "mcp_name": "salesforce.signature_envelope_create",
 "asset_namespace": "salesforce",
 "description": "Create an e-signature envelope for a document with a signer order (POST /restapi/v2.1/accounts/{accountId}/envelopes).",
 "type": "write",
 "target_tables": [
  "signature_envelopes"
 ],
 "parameters": {
  "account_id": "string",
  "account_name": "string",
  "document_title": "string",
  "status": "string",
  "signer_order": "string"
 },
 "input_schema": {
  "type": "object",
  "properties": {
   "account_id": {
    "type": "string",
    "description": "Account the envelope belongs to."
   },
   "account_name": {
    "type": "string",
    "description": "Account display name."
   },
   "document_title": {
    "type": "string",
    "description": "Title of the document to be signed."
   },
   "status": {
    "type": "string",
    "description": "Initial status; defaults to draft."
   },
   "signer_order": {
    "type": "string",
    "description": "Signer order; the SOP mandates customer_first."
   }
  },
  "required": [
   "account_id",
   "document_title"
  ],
  "additionalProperties": false
 }
}