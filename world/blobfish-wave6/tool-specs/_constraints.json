 "naming_rules": {
  "slack": {
   "namespace": "slack",
   "tool_style": "Slack Web API method style, dots->underscores (conversations_list, chat_post_message, users_info, reactions_add, pins_list, usergroups_create, team_info, emoji_list, search_messages)",
   "new_table_prefix": "slack_",
   "may_reuse_tables": [
    "admin_conversations",
    "channels",
    "messages",
    "admin_conversations_ekms",
    "admin_conversations_restrict_accesses",
    "admin_emojis",
    "deal_room_channels_slack_style"
   ]
  },
  "stripe-billing": {
   "namespace": "stripe",
   "tool_style": "REST verb style matching existing stripe tools: get_/post_/delete_ + resource path (get_customers, post_payment_intents, post_invoices_id_finalize)",
   "new_table_prefix": "bare real API name if free (payment_intents, subscriptions, refunds, products, prices, payment_links, coupons), else stripe_",
   "may_reuse_tables": [
    "charges",
    "invoices",
    "disputes",
    "customers",
    "checkout_sessions",
    "balance_transactions",
    "credit_notes",
    "application_fees",
    "billing_meters",
    "billing_alerts",
    "invoice_rendering_templates",
    "amount_details_line_items",
    "identity_verification_sessions",
    "balances",
    "billing_credit_balance_summaries",
    "billing_credit_balance_transactions"
   ]
  },
  "sendgrid-email": {
   "namespace": "email",
   "tool_style": "SendGrid v3 REST style with sg_/mail_ flavor to avoid core-namespace collisions (post_mail_send, get_templates, sg_stats_get). AVOID existing core names like get_marketing_singlesends.",
   "new_table_prefix": "sg_",
   "may_reuse_tables": [
    "blocks",
    "bounces",
    "suppression_groups",
    "category_stats",
    "categories",
    "authentication_domains",
    "certificates",
    "batches",
    "contact_exports",
    "contactdb_segments",
    "singlesends",
    "click_trackings"
   ]
  },
  "jira": {
   "namespace": "jira",
   "tool_style": "jira_ prefix, mcp-atlassian style (jira_search, jira_issue_get, jira_issue_create, jira_issue_transition, jira_comment_add)",
   "new_table_prefix": "jira_",
   "may_reuse_tables": [
    "support_tickets",
    "employees",
    "activity_log_lists"
   ]
  },
  "pagerduty-support": {
   "namespace": "pagerduty",
   "tool_style": "pd_ prefix (pd_incidents_list, pd_incident_manage, pd_oncalls_list, pd_services_list)",
   "new_table_prefix": "pd_",
   "may_reuse_tables": [
    "cases",
    "alerts",
    "billing_alerts",
    "employees"
   ]
  },
  "github": {
   "namespace": "github",
   "tool_style": "gh_ prefix (gh_repos_list, gh_issues_list, gh_issue_create, gh_pull_merge, gh_workflow_runs_list, gh_search_code)",
   "new_table_prefix": "gh_",
   "may_reuse_tables": [
    "agent_sheets",
    "agent_sheet_rows",
    "finance_expense_reports",
    "employees"
   ]
  },
  "notion-docs": {
   "namespace": "notion",
   "tool_style": "notion_ prefix (notion_search, notion_page_get, notion_database_query, notion_blocks_append, notion_comment_create)",
   "new_table_prefix": "notion_",
   "may_reuse_tables": [
    "agent_documents",
    "agent_files",
    "matter_documents"
   ]
  },
  "netsuite-erp": {
   "namespace": "erp",
   "tool_style": "erp_ prefix (erp_sales_orders_list, erp_sales_order_create, erp_invoice_create, erp_items_list, erp_inventory_get)",
   "new_table_prefix": "erp_",
   "may_reuse_tables": [
    "purchase_orders",
    "sourcing_purchase_orders",
    "journal_entries",
    "vendors",
    "customers",
    "sourcing_vendors"
   ]
  },
  "google-calendar": {
   "namespace": "calendar",
   "tool_style": "calendar_ family extending existing convention (calendar_events_list, calendar_events_insert, calendar_freebusy_query, calendar_acl_insert, calendar_settings_list)",
   "new_table_prefix": "cal_",
   "may_reuse_tables": [
    "calendars",
    "calendar_lists",
    "calendar_list_entries",
    "acls",
    "agent_events",
    "colors",
    "meeting_types_and_durations",
    "agent_scheduled_runs"
   ]
  }
