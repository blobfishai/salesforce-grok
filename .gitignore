.env
node_modules/
sim/logs/
data/state/
*.tar.gz
*.log
.DS_Store

# blobfish local world server runtime state (regenerated from seed.db via setup.sh)
world/blobfish/package/*/state.db
world/blobfish/package/*/state.db-*
world/blobfish/package/*/.sessions/
world/blobfish/package/*/traces/

__pycache__/
*.pyc
external/
world/*/package/*/.sessions/
world/*/package/*/state.db
world/*/package/*/traces/

# research evidence corpus: 37 cloned third-party repos (1.9 GB)
# regenerate with scripts/clone-research-repos.sh
research/repos/*/
!research/repos/README.md

# Harbor build payload (regenerated by harbor/sales-world/scripts/build-images.sh)
harbor/sales-world/images/world/payload/

# world package backups + runtime friction files
world/*/package/*/*.bak
world/*/package/*/state.db.bf-friction

# Harbor agent transcripts: these capture container `env` output, which has
# leaked live API keys into commits before. Results of record live in verifier/.
harbor/sales-world/jobs/**/agent/
# Same hazard, same rule: the crmarena-parity slice-grok transcripts carry the
# live XAI_API_KEY 44 times. Results of record live in docs/HARBOR-RESULTS.md.
harbor/crmarena-parity/jobs/**/agent/

# CRMArena dataset mirror (re-downloadable from HuggingFace; see ingest adapter)
research/parity/crmarena/*.json
# CRMArena-Pro mirror, same provenance (HF Salesforce/CRMArenaPro)
research/parity/crmarena-pro/*.json

harbor/crmarena-parity/images/world/crmarena_data.db

# Compiled Harbor task dirs (regenerable: scripts/ingest/compile_tasks.py from the WCPs).
# Task suites live at the repo root; the two committed ones are tasks/sales-world (20,
# hand-authored) and tasks/crmarena (27). Everything below is generated bulk.
tasks/crmarena-full/
tasks/crmarena-waves/
tasks/crmarena-slice/
